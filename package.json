{
  "name": "root",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "test": "pnpm -r test",
    "test-only": "pnpm -r run test-only",
    "bin-lint": "eslint 'bin/*.js'",
    "reset": "bin/clean-all-modules.sh && pnpm install",
    "check-unused": "bin/check-unused.sh",
    "format": "npx prettier --write .",
    "README": "echo 'For new versions, run patch-versions and pre-push before pushing to the repo. Then, in the main branch, run publish-changed to publish the packages with new versions.'",
    "patch-versions": "node bin/patch-versions.js",
    "pre-push": "npm run format && node bin/pre-push.js",
    "publish-changed": "node bin/publish-changed-packages.js",
    "patch-for-push": "npm run reset && npm run patch-versions && npm run pre-push"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "fs-extra": "^9.1.0",
    "prettier": "^2.8.8",
    "globals": "^16.0.0",
    "@eslint/js": "^9.39.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
